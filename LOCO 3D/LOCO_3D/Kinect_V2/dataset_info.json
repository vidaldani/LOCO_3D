{
  "info": {
    "name": "LOCO 3D — Logistics Objects with 3D Annotations (Kinect V2)",
    "description": "3D bounding box annotations of logistics objects (pallets, small load carriers, stillages, forklifts, pallet trucks) captured with a Microsoft Kinect V2 in real warehouse environments.",
    "version": "1.0",
    "year": 2026,
    "maintainer": "Daniel Vidal",
    "email": "daniel.vidal@tum.de",
    "institution": "Technical University of Munich (TUM)"
  },
  "sensor": {
    "name": "Microsoft Kinect V2",
    "image_size_px": [1920, 1080],
    "depth_size_px": [512, 424],
    "depth_unit": "mm",
    "depth_format": "uint16_npy",
    "axes": {
      "x": "right",
      "y": "down",
      "z": "forward"
    }
  },
  "annotation_format": {
    "bbox_2d_format": "xywh_pixels",
    "segmentation_format": "polygon_pixels",
    "bbox_3d_units": "meters",
    "bbox_3d_frame": "camera",
    "bbox_3d_center": "geometric_center",
    "bbox_3d_rotation": {
      "yaw": "degrees_around_y_axis",
      "rx": "degrees_around_x_axis",
      "rz": "degrees_around_z_axis"
    }
  }
}
